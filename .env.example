# Plantilla de variables de entorno para docker-compose.yml (raiz del repositorio).
# Copiar a .env (no versionado): copy .env.example .env
# Generar cada clave con: python -c "import secrets; print(secrets.token_hex(32))"
# Usar claves distintas entre si, hexadecimales o alfanumericas (van dentro de una URL).
# POSTGRES_USER y POSTGRES_DB deben coincidir con los del volumen postgres_data existente.
# Todas las variables de este archivo son obligatorias: si falta alguna, docker compose falla.
# Para el backend sin Docker (DATABASE_URL, ALGORITHM, ACCESS_TOKEN_EXPIRE_MINUTES)
# ver 04_CODIGO/BACKEND/.env.example.

# Base de datos PostgreSQL (servicio db; el compose construye la DATABASE_URL del backend con host db)
POSTGRES_DB=nombre_bd_local
POSTGRES_USER=usuario_bd_local
POSTGRES_PASSWORD=cambiar_por_clave_segura

# Clave de firma JWT de sesion (se inyecta al servicio backend)
SECRET_KEY=cambiar_por_clave_segura_sesion

# Clave de firma JWT de los enlaces del visor de planos (se inyecta al servicio backend)
JWT_SECRET_KEY_PLANOS=cambiar_por_clave_segura_planos
