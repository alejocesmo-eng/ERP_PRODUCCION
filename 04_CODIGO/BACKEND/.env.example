# Plantilla de variables de entorno para el backend sin Docker (uvicorn app.main:app).
# Copiar a .env en esta carpeta (no versionado): copy .env.example .env
# Generar cada clave con: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY y JWT_SECRET_KEY_PLANOS deben ser los mismos valores del .env de la raiz.

# OBLIGATORIA. Host localhost (no db, que solo existe dentro de la red de Docker).
# Driver postgresql:// sincrono (no asyncpg). Usuario y base iguales a los del volumen existente.
DATABASE_URL=postgresql://usuario_bd_local:cambiar_por_clave_segura@localhost:5432/nombre_bd_local

# OBLIGATORIA. Clave de firma JWT de sesion.
SECRET_KEY=cambiar_por_clave_segura_sesion

# OBLIGATORIA. Clave de firma JWT de los enlaces del visor de planos.
JWT_SECRET_KEY_PLANOS=cambiar_por_clave_segura_planos

# Opcionales (si se omiten se usan estos mismos valores por defecto).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de pruebas desechable (plantilla sgi_test_template + copia). Ver scripts/preparar_plantilla_pruebas.py.
# Sin clave en las URL: la clave del usuario va solo en la variable de sesion PGPASSWORD.
# Conexion de administracion (usuario con CREATEDB, base de mantenimiento postgres):
# SGI_TEST_PG_ADMIN_URL=postgresql://usuario_bd_local@localhost:5432/postgres
# Para trabajar contra la copia, usar la URL que imprime scripts/crear_copia_pruebas.py:
# DATABASE_URL=postgresql://usuario_bd_local@localhost:5432/sgi_test_copia
# SGI_TEST_PG_URL=postgresql://usuario_bd_local@localhost:5432/sgi_test_copia
