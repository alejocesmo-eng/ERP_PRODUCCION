# Si frontend y backend comparten dominio, la ruta relativa predeterminada funciona.
# Para un backend alojado en otro dominio, configure su URL completa antes de compilar.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Solo desarrollo: clave de los botones "Acceso de Pruebas (Dev Mode)" del login.
# Póngala en .env.local (no versionado) con el mismo valor que SGI_SANDBOX_DEMO_PASSWORD.
# VITE_DEV_LOGIN_PASSWORD=
